# Only needed for LOCAL DEVELOPMENT, where the Vite dev server (port 5173)
# and the Express/Socket.IO server (port 5000) run separately.
#
# In production (single Render service), leave these UNSET — the client is
# served by the same server, so it just uses relative/same-origin URLs.
VITE_API_URL=http://localhost:5000/api
VITE_SOCKET_URL=http://localhost:5000
